# Salin menjadi .env di folder root, lalu: docker compose up -d --build
APP_PORT=8080
APP_URL=http://localhost:8080

DB_NAME=sim_workshop_unand
DB_USER=workshop
DB_PASSWORD=ganti_sandi_database
DB_ROOT_PASSWORD=ganti_sandi_root

# WAJIB diganti untuk server sungguhan: minimal 32 karakter acak
JWT_SECRET=ganti_dengan_rahasia_acak_minimal_32_karakter_ya

# true bila diakses lewat HTTPS
COOKIE_SECURE=false

# Isi data demo saat database pertama kali kosong
SEED_DEMO=true

# SMTP (opsional). Kosong = email hanya dicatat di tabel email_outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Workshop UNAND <no-reply@unand.ac.id>
