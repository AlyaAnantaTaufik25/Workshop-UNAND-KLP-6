{
  "name": "sim-workshop-unand-backend",
  "version": "1.0.0",
  "description": "Backend API untuk Sistem Informasi Manajemen Workshop Universitas Andalas (UNAND)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seeders/seed.js",
    "db:reset": "npm run db:fresh",
    "db:migrate:status": "node database/migrate.js --status",
    "db:fresh": "node database/migrate.js --fresh && node database/seeders/seed.js",
    "test:health": "node tests/health.smoke.js"
  },
  "keywords": [
    "workshop",
    "unand",
    "express",
    "mysql",
    "rest-api"
  ],
  "author": "Backend Team - SIM Workshop UNAND",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
