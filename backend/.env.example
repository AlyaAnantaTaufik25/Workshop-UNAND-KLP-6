# Application Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# CORS Configuration (comma separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
