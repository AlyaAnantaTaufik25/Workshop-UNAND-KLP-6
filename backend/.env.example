# Application Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# CORS Configuration (comma separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sim_workshop_unand
DB_CONNECTION_LIMIT=10

# JWT Authentication (for future auth module)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=1d


# ── Sesi & keamanan ───────────────────────────────────────
# Production: WAJIB JWT_SECRET acak minimal 32 karakter
# COOKIE_SECURE=true      # paksa cookie Secure (default: true hanya di production)
# TRUST_PROXY=1           # bila di belakang reverse proxy (nginx/Docker)
# RATE_LIMIT_LOGIN=30     # percobaan login per 15 menit per IP (dev: 300)
# RATE_LIMIT_API=1200     # permintaan API per menit per IP

# ── Alamat publik (email, QR sertifikat, URL berkas) ──────
APP_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5000
# UPLOAD_DIR=./uploads

# ── Email notifikasi ──────────────────────────────────────
# Kosongkan SMTP_HOST = email hanya dicatat di tabel email_outbox (status 'logged')
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Workshop UNAND <no-reply@unand.ac.id>
# MAIL_ENABLED=false     # matikan antrean email sepenuhnya

# ── Tugas latar (pengingat H-1 & pengiriman email) ────────
# SCHEDULER_ENABLED=false
